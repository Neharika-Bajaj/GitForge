# GitForge Backend Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/gitforge

# JSON Web Token Secret Key
JWT_SECRET_KEY=your_jwt_secret_key_here

# Frontend Application URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# GitForge API Server URL (for CLI commands like login, push, pull, revert)
SERVER_URL=http://localhost:3000
